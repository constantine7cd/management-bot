DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://management:change-this-database-password@db:5432/management
REDIS_URL=redis://redis:6379/0
COMPANY_TIME_ZONE=Europe/Chisinau
LOCATION_RETENTION_DAYS=90
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://attendance.example.com
DOMAIN=attendance.example.com
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
SENTRY_DSN=
RESTIC_REPOSITORY=s3:s3.example.com/bucket/management-bot
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
